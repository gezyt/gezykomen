# Salin berkas ini menjadi .env di VPS bila mau memakai berkas env,
# atau isi langsung di gezykomen.service (Environment=...).
# JANGAN commit berkas .env yang sudah terisi ke Git.
# Buat salt acak dengan: openssl rand -hex 16

# Port layanan (default 3102, jangan pakai 3100 GezyBoard / 3101 GezyView)
PORT=3102

# Lokasi database SQLite (satu berkas, cukup disalin untuk backup)
DB_PATH=/opt/gezykomen/data/gezykomen.db

# Origin blog yang boleh memanggil API (dipisah koma, tanpa spasi)
GEZYKOMEN_ORIGINS=https://site.pakgun.web.id,https://pakgun.gezytech.web.id

# Salt untuk hash IP (dipakai rate limit, IP asli tidak disimpan)
GEZYKOMEN_SALT=ISI-SALT-ACAK-DI-SINI
