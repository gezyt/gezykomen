# Salin berkas ini menjadi .env, lalu isi nilai aslinya.
# JANGAN commit berkas .env yang sudah terisi ke Git.
# Buat kata sandi dan JWT_TOKEN yang panjang dan acak, misal dengan:
#   openssl rand -hex 32

# Database Waline di MariaDB VPS (database + user sendiri, bukan gezycbt)
MYSQL_DB=waline
MYSQL_USER=waline
MYSQL_PASSWORD=ISI-KATA-SANDI-USER-WALINE-DI-SINI

# Token acak untuk login admin Waline (bukan kata sandi admin)
JWT_TOKEN=ISI-STRING-ACAK-PANJANG-DI-SINI

# Blog yang dilayani komentarnya
SITE_NAME=Blog Pak Gun
SITE_URL=https://site.pakgun.web.id
SECURE_DOMAINS=site.pakgun.web.id

# Email admin (dipakai Waline untuk mengenali pemilik blog)
AUTHOR_EMAIL=email-pakgun@example.com
